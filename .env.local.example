# Copy this file to .env.local and fill in the values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Server-only, needed to save customer orders. Supabase dashboard ->
# Project Settings -> API Keys -> Secret keys (sb_secret_...), or the
# legacy service_role key. Never share it or put it in client code.
# The older name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=

# Your public site URL, once you connect a domain (used for SEO + sitemap).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
